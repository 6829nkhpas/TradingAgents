# Research API server.
# Bind to 127.0.0.1 for local, non-Docker runs; the Docker image binds 0.0.0.0.
#TRADINGAGENTS_API_HOST=127.0.0.1
#TRADINGAGENTS_API_PORT=8000
# Optional bearer key, off by default. With it set, every /api/v1/research call
# needs "Authorization: Bearer <key>". Set it whenever the API is reachable from
# anything beyond a private network.
#TRADINGAGENTS_API_KEY=replace-with-a-long-random-secret

# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# CoinGecko (crypto fundamentals: supply, valuation, developer and community data).
# A free Demo key from https://www.coingecko.com/en/api works; set COINGECKO_API_PLAN=pro
# for a Pro key. Without a key, crypto fundamentals use Yahoo Finance only.
COINGECKO_API_KEY=
#COINGECKO_API_PLAN=demo

# SEC EDGAR (US company filings, point-in-time). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# FRED (Federal Reserve macro data for the news analyst). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Alpha Vantage (optional alternative news/fundamentals vendor).
#ALPHA_VANTAGE_API_KEY=

# TypeSafe Jev: screens StockTwits and Reddit posts for the Sentiment Analyst. Optional.
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-latest

# Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp, relays). Local servers need no key.
#OPENAI_COMPATIBLE_API_KEY=
#TRADINGAGENTS_LLM_PROVIDER=openai_compatible
#TRADINGAGENTS_LLM_BACKEND_URL=https://your-relay.example/v1
#TRADINGAGENTS_QUICK_THINK_LLM=your-model-id

# AWS Bedrock (pip install ".[bedrock]"). Bearer token, or the AWS credential chain; set the region either way.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# Remote Ollama server. Unset uses http://localhost:11434/v1.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Override these DEFAULT_CONFIG keys.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_TOOL_ROUNDS=8

# Research runs: at most this many execute at once; the rest queue.
#TRADINGAGENTS_MAX_CONCURRENT_RUNS=2
# Each symbol keeps its latest result: a request is answered from it at once and
# queues a background refresh (one per symbol at a time). Set a minimum age to
# skip refreshing a result that is still fresh; 0 refreshes on every request.
#TRADINGAGENTS_RESEARCH_REFRESH_MIN_AGE_SECONDS=0
# Results are kept in <cache dir>/research_results.json so a restart serves them.
#TRADINGAGENTS_RESEARCH_PERSIST=true
#TRADINGAGENTS_RESEARCH_STORE_PATH=

# Per-request LLM timeout in seconds.
#TRADINGAGENTS_LLM_TIMEOUT=90

# Docker: a host folder for the data cache (unset: the tradingagents_data volume).
#TRADINGAGENTS_DATA_DIR=./data

# Data cache path. Unset uses ~/.tradingagents/cache.
#TRADINGAGENTS_CACHE_DIR=

# Lower temperature means less run-to-run variation on models that honor it.
#TRADINGAGENTS_TEMPERATURE=0.0

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens to bound a model that runs long and trips a timeout.
#TRADINGAGENTS_MAX_TOKENS=8192

# Reasoning depth per provider.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high
